# Secrets and local configuration
.env
.env.*
!.env.example
config/agent.local.yaml
config/*.local.*
*.pem
*.key
secrets/
credentials/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Datasets, caches, and models: keep directory structure and READMEs in Git, ignore binaries/data
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep
!data/interim/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
data/cache/*
!data/cache/.gitkeep
!data/cache/README.md
experiments/**/data/*
!experiments/**/data/.gitkeep
!experiments/**/data/README.md

# Common dataset and model binary formats
*.npz
*.h5ad
*.h5
*.mat
*.parquet
*.feather
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.gguf
models/
checkpoints/

# Figures and images (keep READMEs and .gitkeep, ignore generated image binaries)
**/figures/*
!**/figures/.gitkeep
!**/figures/README.md
*.png
*.jpg
*.jpeg
*.svg
*.eps
*.tif
*.tiff

# Experiment outputs and logs
results/*
!results/README.md
!results/figures/
!results/tables/
results/figures/*
!results/figures/.gitkeep
!results/figures/README.md
results/tables/*
!results/tables/.gitkeep
!results/tables/README.md
logs/*
!logs/.gitkeep
*.log
wandb/
mlruns/
.lightning/

# Notebooks
.ipynb_checkpoints/

# Manuscripts, LaTeX sources, paper.tex, and build products (kept local, documented via README)
paper.tex
*.tex
*.bib
*.bst
*.cls
*.sty
*.pdf
*.zip
*.tar.gz
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
!paper/README.md
