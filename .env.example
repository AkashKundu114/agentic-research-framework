# Copy to .env for local development. Never commit real credentials.
# Keep secrets out of command-line arguments and logs.

APP_ENV=development
LOG_LEVEL=INFO

# Optional local inference endpoint; leave unset if not used.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=your-local-model

# Optional dataset root outside Git.
# DATA_ROOT=/absolute/path/to/private-or-large-datasets
